# Скопируй этот файл в .env и заполни.
# .env лежит рядом с Remoter.exe (или в корне проекта при dotnet run).

# Токен от @BotFather. Обязателен. Никому не показывай и не коммить.
TELEGRAM_BOT_TOKEN=

# Твой Telegram user ID (бот пришлёт его после первого /start).
# Можно несколько через запятую. Пока список пуст, бот работает
# в режиме настройки: отвечает только ID и ничего не выполняет.
ALLOWED_USER_IDS=

# Необязательные переопределения (см. appsettings.json)
# Рабочая папка по умолчанию. "~" — домашняя папка пользователя.
# DEFAULT_DIRECTORY=~
# MODEL_ID=deepseek-v4.1-flash-free
# MODEL_PROVIDER=opencode
# AGENT=build
# APPROVAL_TIMEOUT_SECONDS=300
# AUTO_START_OPENCODE=true
# OPENCODE_COMMAND=opencode.cmd

# Не давать ПК уходить в сон, пока работает Remoter.
# PREVENT_SLEEP=false
